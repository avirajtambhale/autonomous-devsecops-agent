# Streamlit Cloud secrets — copy to .streamlit/secrets.toml
# or add via Streamlit Cloud dashboard > App Settings > Secrets

# The dashboard reads these from the environment or secrets.toml
API_BASE_URL = "https://your-reviewer-api.com"
