FROM python:3.11-slim

RUN groupadd -r dashboard && useradd -r -g dashboard -u 1002 dashboard

WORKDIR /app

RUN pip install --no-cache-dir \
    streamlit==1.35.0 \
    httpx==0.27.0 \
    pandas==2.2.2 \
    plotly==5.22.0

COPY --chown=dashboard:dashboard dashboard/ ./dashboard/

USER dashboard

ENV PYTHONUNBUFFERED=1

EXPOSE 8501

HEALTHCHECK --interval=30s --timeout=10s CMD curl -f http://localhost:8501/_stcore/health || exit 1

CMD ["streamlit", "run", "dashboard/app.py", \
     "--server.port=8501", "--server.address=0.0.0.0", \
     "--server.headless=true", "--browser.gatherUsageStats=false"]
