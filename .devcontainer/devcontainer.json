{
  "name": "AI Code Reviewer",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "customizations": {
    "codespaces": {
      "openFiles": ["README.md", "dashboard/app.py"]
    },
    "vscode": {
      "settings": {},
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff"
      ]
    }
  },
  "updateContentCommand": "pip3 install --user -r requirements.txt; echo 'Done'",
  "postAttachCommand": {
    "server": "streamlit run dashboard/app.py --server.enableCORS false --server.enableXsrfProtection false"
  },
  "portsAttributes": {
    "8501": {"label": "Dashboard", "onAutoForward": "openPreview"}
  },
  "forwardPorts": [8501]
}
