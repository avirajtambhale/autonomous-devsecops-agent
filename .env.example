# =============================================================
# AI Code Reviewer — Environment Configuration  v2.0
# Copy to .env and fill in values. NEVER commit .env.
# =============================================================

# Application
ENVIRONMENT=development          # development | staging | production
LOG_LEVEL=INFO

# GitHub Integration (required)
GITHUB_TOKEN=ghp_your_token_here
GITHUB_WEBHOOK_SECRET=your_webhook_secret
GITHUB_API_URL=https://api.github.com

# LLM (Agent C patch generation)
LLM_PROVIDER=openai              # openai | anthropic | local
LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=4096
OPENAI_API_KEY=sk-your-key-here
# ANTHROPIC_API_KEY=sk-ant-your-key-here

# Redis + ARQ Task Queue
REDIS_URL=redis://localhost:6379/0
USE_REDIS_STORE=true
ARQ_MAX_JOBS=20
ARQ_JOB_TIMEOUT=600

# OpenTelemetry
OTEL_ENABLED=true
OTEL_SERVICE_NAME=ai-code-reviewer
OTEL_SERVICE_VERSION=1.0.0
OTLP_ENDPOINT=http://localhost:4317          # Jaeger / Grafana Tempo / Honeycomb
OTLP_HEADERS=                                # e.g. x-honeycomb-team=your-api-key
OTEL_SAMPLE_RATE=1.0

# LangSmith Tracing (Agent C LLM calls)
LANGSMITH_ENABLED=false
LANGSMITH_API_KEY=ls__your_key_here
LANGSMITH_PROJECT=ai-code-reviewer
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Tree-sitter AST Parsing
TREESITTER_ENABLED=true          # false = fallback to regex diff parser

# Sandbox Docker
SANDBOX_IMAGE=ai-reviewer-sandbox:latest
SANDBOX_NETWORK=none
SANDBOX_TIMEOUT_SECONDS=120
SANDBOX_MEMORY_LIMIT=512m
SANDBOX_CPU_QUOTA=50000

# Feature flags
ENABLE_PATCH_GENERATION=true
ENABLE_PR_COMMENTS=true
ENABLE_PR_STATUS_CHECKS=true
SKIP_DRAFT_PRS=true
